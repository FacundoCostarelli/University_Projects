<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="uart_tb_behav.wdb" id="1">
         <top_modules>
            <top_module name="uart_tb" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="180.166666 us"></ZoomStartTime>
      <ZoomEndTime time="5,965.166667 us"></ZoomEndTime>
