   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="286"></NameColumnWidth>
      <ValueColumnWidth column_width="93"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="14" />
   <wvobject fp_name="/uart_tb/clk" type="logic">
